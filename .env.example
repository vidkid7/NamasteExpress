# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Use a local development database or configure the cPanel PostgreSQL database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ─── NEXTAUTH ─────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_URL="https://your-domain.example"
NEXTAUTH_SECRET="REPLACE_WITH_GENERATED_SECRET"
AUTH_SECRET="REPLACE_WITH_GENERATED_SECRET"

# ─── GOOGLE OAUTH (optional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Set true only after GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET are configured.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="false"

# ─── SMTP (optional - for email verification & password reset) ────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@namastexpress.com"

# ─── CLOUDINARY (for image uploads) ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Use "cloudinary" in production so uploaded article images stay available
# after deploys/restarts and across app instances. Use "local" only for dev.
STORAGE_PROVIDER="cloudinary"

# ─── REDIS (optional) ────────────────────────────────────────────────────────
REDIS_URL=""

# ─── SITE URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://your-domain.example"

# ─── ADMIN IP WHITELIST (optional, comma-separated) ──────────────────────────
ADMIN_IP_WHITELIST=""

# ─── ADMIN PANEL SECRET URL PATH ─────────────────────────────────────────────
# The admin panel will be accessible at /<ADMIN_SECRET_PATH> instead of /admin.
# Set to a random string like "secure-panel-x7k9m2" to hide the admin panel.
# If left as "admin" (default), the standard /admin path is used.
ADMIN_SECRET_PATH="admin"
NEXT_PUBLIC_ADMIN_SECRET_PATH="admin"

# ─── PRODUCTION SEEDING ONLY ─────────────────────────────────────────────────
# Required only if you intentionally run `npm run db:seed` with NODE_ENV=production.
SEED_ADMIN_PASSWORD=""
SEED_EDITOR_PASSWORD=""
SEED_AUTHOR_PASSWORD=""
